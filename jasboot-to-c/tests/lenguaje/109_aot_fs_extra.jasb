/* Paridad VM vs AOT: fs_leer_texto, fs_tamano, fs_copiar, fs_borrar, fs_mover, fs_listar.
   verify_vm_aot: cwd = raíz del repo. run-jasb: cwd = carpeta del .jasb. */
principal
    pausa_milisegundos(1000)
    texto r = "tmp_109_onlyone_zz.txt"
    pausa_milisegundos(1000)
    entero h = fs_abrir(r, "w")
    pausa_milisegundos(1000)
    fs_escribir("abc", h)
    pausa_milisegundos(1000)
    fs_cerrar(h)
    pausa_milisegundos(1000)
    imprimir fs_tamano(r)
    pausa_milisegundos(1000)
    texto t = fs_leer_texto(r)
    pausa_milisegundos(1000)
    imprimir longitud_texto(t)
    pausa_milisegundos(1000)
    texto glo = fs_listar("tmp_109_onlyone_zz*")
    pausa_milisegundos(1000)
    imprimir longitud_texto(glo)
    pausa_milisegundos(1000)
    imprimir fs_copiar(r, "tmp_109_onlyone_copy.txt")
    pausa_milisegundos(1000)
    imprimir existe_archivo("tmp_109_onlyone_copy.txt")
    pausa_milisegundos(1000)
    fs_borrar("tmp_109_onlyone_copy.txt")
    pausa_milisegundos(1000)
    imprimir existe_archivo("tmp_109_onlyone_copy.txt")
    pausa_milisegundos(1000)
    imprimir fs_mover(r, "tmp_109_onlyone_moved.txt")
    pausa_milisegundos(1000)
    imprimir existe_archivo(r)
    pausa_milisegundos(1000)
    imprimir existe_archivo("tmp_109_onlyone_moved.txt")
    /* Dejar tmp_109_onlyone_moved.txt en disco ~5 s para inspección manual; luego limpiar */
    pausa_milisegundos(5000)
    fs_borrar("tmp_109_onlyone_moved.txt")
fin_principal
